# ============================================================
# CONFIGURAÇÕES AWS
# ============================================================
# Obtenha estas credenciais na console AWS IAM
# Nunca commite .env com credenciais reais — use este arquivo como template
AWS_ACCESS_KEY_ID=seu-access-key-aqui
AWS_SECRET_ACCESS_KEY=sua-secret-key-aqui
AWS_DEFAULT_REGION=us-east-1

# ============================================================
# S3 BUCKET
# ============================================================
# Nome do bucket S3 onde os dados serão salvos
S3_BUCKET=seu-bucket-nome

# ============================================================
# DATABRICKS (OPCIONAL)
# ============================================================
# Token de autenticação Databricks para upload de scripts
DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com
DATABRICKS_TOKEN=seu-token-aqui

# ============================================================
# AWS PROFILE (OPCIONAL)
# ============================================================
# Se usando profiles do AWS CLI, defina o nome do profile
# Padrão: "default"
AWS_PROFILE=open-meteo

# ============================================================
# NOTIFICAÇÃO (OPCIONAL — usado por scripts/run_and_notify.sh)
# ============================================================
# Tópico do ntfy.sh (https://ntfy.sh/<topico>) para alertas de sucesso/falha
# do cron na VM. Gere um nome longo e aleatório — funciona como segredo.
NTFY_TOPIC=seu-topico-aleatorio-aqui
