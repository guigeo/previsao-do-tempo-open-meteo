              },
              "frame": { "showTitle": true, "title": "Chuva acumulada (7 dias)" }
            }
          },
          "position": { "x": 6, "y": 15, "width": 6, "height": 6 }
        }
      ]
    },
    {
      "name": "horario_rankings",
      "displayName": "Horário · Rankings · Carga",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "hr_title",
            "multilineTextboxSpec": { "lines": ["## 🕐 Perfil horário, rankings e controle de carga"] }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 1 }
        },
        {
          "widget": {
            "name": "hr_header_hora",
            "multilineTextboxSpec": { "lines": ["### Perfil horário nacional"] }
          },
          "position": { "x": 0, "y": 1, "width": 12, "height": 1 }
        },
        {
