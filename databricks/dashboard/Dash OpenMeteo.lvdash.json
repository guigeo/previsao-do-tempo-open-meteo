        {
          "widget": {
            "name": "kpi_amplitude",
            "queries": [ { "name": "main_query", "query": { "datasetName": "kpis", "fields": [ { "name": "amplitude_media", "expression": "`amplitude_media`" } ], "disaggregated": true } } ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "amplitude_media", "displayName": "Amplitude térmica (°C)", "format": { "type": "number", "decimalPlaces": { "type": "fixed", "places": 1 } } } },
              "frame": { "showTitle": true, "title": "Amplitude térmica média" }
            }
          },
          "position": { "x": 9, "y": 2, "width": 3, "height": 3 }
        },
        {
          "widget": {
            "name": "vg_header_mapa",
            "multilineTextboxSpec": { "lines": ["### 🗺️ Mapa térmico (longitude × latitude) e distribuições"] }
          },
          "position": { "x": 0, "y": 5, "width": 12, "height": 1 }
        },
        {
          "widget": {
            "name": "vg_mapa",
            "queries": [ { "name": "main_query", "query": { "datasetName": "mapa", "fields": [ { "name": "longitude", "expression": "`longitude`" }, { "name": "latitude", "expression": "`latitude`" }, { "name": "temp_media", "expression": "`temp_media`" }, { "name": "chuva_media", "expression": "`chuva_media`" } ], "disaggregated": true } } ],
            "spec": {
              "version": 3,
              "widgetType": "scatter",
              "encodings": {
                "x": { "fieldName": "longitude", "scale": { "type": "quantitative" }, "axis": { "title": "Longitude" } },
                "y": { "fieldName": "latitude", "scale": { "type": "quantitative" }, "axis": { "title": "Latitude" } },
                "color": { "fieldName": "temp_media", "scale": { "type": "quantitative" }, "legend": { "title": "Temp. média °C" } },
                "size": { "fieldName": "chuva_media", "scale": { "type": "quantitative" } }
              },
              "frame": { "showTitle": true, "title": "Municípios por temperatura média (contorno do Brasil)" }
            }
          },
          "position": { "x": 0, "y": 6, "width": 8, "height": 7 }
        },
        {
          "widget": {
            "name": "vg_pie_temp",
            "queries": [ { "name": "main_query", "query": { "datasetName": "classif_temp", "fields": [ { "name": "sum(qtd)", "expression": "SUM(`qtd`)" }, { "name": "categoria", "expression": "`categoria`" } ], "disaggregated": false } } ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": { "fieldName": "sum(qtd)", "scale": { "type": "quantitative" } },
