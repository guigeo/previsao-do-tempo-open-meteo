{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "kpis",
      "queryLines": [
        "SELECT COUNT(DISTINCT codigo_ibge) AS municipios, COUNT(DISTINCT uf) AS ufs, ROUND(AVG((temp_max_c+temp_min_c)/2),1) AS temp_media_nacional, ROUND(AVG(teve_chuva),3) AS pct_dias_com_chuva, ROUND(AVG(amplitude_termica_c),1) AS amplitude_media FROM open_meteo.gold.clima_dia_historico"
      ]
    },
    {
      "name": "mapa",
      "displayName": "mapa",
      "queryLines": [
        "SELECT municipio, uf, latitude, longitude, ROUND(AVG((temp_max_c+temp_min_c)/2),1) AS temp_media, ROUND(AVG(precipitacao_total_mm),1) AS chuva_media FROM open_meteo.gold.clima_dia_historico GROUP BY municipio, uf, latitude, longitude"
      ]
    },
    {
      "name": "classif_temp",
      "displayName": "classif_temp",
      "queryLines": [
        "SELECT classificacao_temperatura AS categoria, COUNT(*) AS qtd FROM open_meteo.gold.clima_dia_historico GROUP BY classificacao_temperatura"
      ]
    },
    {
      "name": "classif_chuva",
      "displayName": "classif_chuva",
      "queryLines": [
        "SELECT classificacao_chuva AS categoria, COUNT(*) AS qtd FROM open_meteo.gold.clima_dia_historico GROUP BY classificacao_chuva"
      ]
    },
    {
      "name": "recordes",
      "displayName": "recordes",
      "queryLines": [
        "SELECT tipo_extremo, municipio, uf, CAST(data AS STRING) AS data, ROUND(valor,1) AS valor FROM (SELECT tipo_extremo, municipio, uf, data, valor, ROW_NUMBER() OVER (PARTITION BY tipo_extremo ORDER BY valor * (CASE WHEN tipo_extremo='temp_min_menor' THEN 1 ELSE -1 END)) AS rn FROM open_meteo.gold.clima_extremo) WHERE rn = 1 ORDER BY tipo_extremo"
      ]
    },
    {
      "name": "extremo_full",
      "displayName": "extremo_full",
      "queryLines": [
        "SELECT CAST(data AS STRING) AS data, tipo_extremo, municipio, uf, ROUND(valor,1) AS valor FROM open_meteo.gold.clima_extremo ORDER BY data DESC, tipo_extremo"
      ]
    },
    {
      "name": "extremo_ranking",
      "displayName": "extremo_ranking",
      "queryLines": [
        "SELECT concat(municipio,' - ',uf) AS mun_uf, COUNT(*) AS recordes FROM open_meteo.gold.clima_extremo GROUP BY municipio, uf ORDER BY recordes DESC LIMIT 12"
      ]
    },
    {
      "name": "tendencia",
      "displayName": "tendencia",
      "queryLines": [
        "SELECT data, concat(municipio,' - ',uf) AS mun_uf, uf, ROUND((temp_max_c+temp_min_c)/2,1) AS temp_media, ROUND(media_movel_7d_temp,1) AS mm7, ROUND(media_movel_30d_temp,1) AS mm30, ROUND(anomalia_temp,1) AS anomalia_temp, ROUND(chuva_7d,1) AS chuva_7d FROM open_meteo.gold.clima_tendencia"
      ]
    },
    {
      "name": "serie_nacional",
      "displayName": "serie_nacional",
      "queryLines": [
        "SELECT data, ROUND(AVG((temp_max_c+temp_min_c)/2),1) AS temp_media, ROUND(AVG(temp_max_c),1) AS temp_max, ROUND(AVG(temp_min_c),1) AS temp_min FROM open_meteo.gold.clima_dia_historico GROUP BY data"
      ]
    },
    {
      "name": "perfil_hora",
      "displayName": "perfil_hora",
      "queryLines": [
        "SELECT hora, ROUND(AVG(temperatura_c),1) AS temp_media, ROUND(AVG(umidade_relativa),0) AS umidade_media FROM open_meteo.gold.clima_hora_analitico GROUP BY hora"
      ]
    },
    {
      "name": "periodo",
      "displayName": "periodo",
      "queryLines": [
        "SELECT periodo_dia, ROUND(AVG(temperatura_c),1) AS temp_media, ROUND(SUM(teve_chuva)/COUNT(*),3) AS pct_chuva FROM open_meteo.gold.clima_hora_analitico GROUP BY periodo_dia"
      ]
    },
    {
      "name": "ranking_quentes",
      "displayName": "ranking_quentes",
      "queryLines": [
        "SELECT concat(municipio,' - ',uf) AS mun_uf, ROUND(MAX(temp_max_c),1) AS temp_max FROM open_meteo.gold.clima_dia_historico GROUP BY municipio, uf ORDER BY temp_max DESC LIMIT 10"
      ]
    },
    {
      "name": "ranking_frios",
      "displayName": "ranking_frios",
      "queryLines": [
        "SELECT concat(municipio,' - ',uf) AS mun_uf, ROUND(MIN(temp_min_c),1) AS temp_min FROM open_meteo.gold.clima_dia_historico GROUP BY municipio, uf ORDER BY temp_min ASC LIMIT 10"
      ]
    },
    {
      "name": "uf_agg",
      "displayName": "uf_agg",
      "queryLines": [
        "SELECT uf, ROUND(AVG((temp_max_c+temp_min_c)/2),1) AS temp_media, ROUND(AVG(precipitacao_total_mm),1) AS chuva_media FROM open_meteo.gold.clima_dia_historico GROUP BY uf"
      ]
    },
    {
      "name": "carga",
      "displayName": "carga",
      "queryLines": [
        "SELECT CAST(MIN(data) AS STRING) AS data_min, CAST(MAX(data) AS STRING) AS data_max, COUNT(DISTINCT data) AS dias_processados, COUNT(DISTINCT codigo_ibge) AS municipios, DATEDIFF(CURRENT_DATE(), MAX(data)) AS dias_desde_ultima FROM open_meteo.gold.clima_dia_historico"
      ]
    }
  ],
  "pages": [
    {
      "name": "visao_geral",
      "displayName": "Visão Geral",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "vg_title",
            "multilineTextboxSpec": { "lines": ["## ☀️ Clima Brasil · Open-Meteo"] }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 1 }
        },
        {
          "widget": {
            "name": "vg_subtitle",
            "multilineTextboxSpec": { "lines": ["Panorama climático diário (D-1) dos municípios brasileiros · catálogo open_meteo (Gold)"] }
          },
          "position": { "x": 0, "y": 1, "width": 12, "height": 1 }
        },
        {
          "widget": {
            "name": "kpi_municipios",
            "queries": [ { "name": "main_query", "query": { "datasetName": "kpis", "fields": [ { "name": "municipios", "expression": "`municipios`" } ], "disaggregated": true } } ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "municipios", "displayName": "Municípios" } },
