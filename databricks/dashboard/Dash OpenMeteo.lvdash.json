    {
      "name": "ce649dc1",
      "displayName": "controle_carga",
      "queryLines": [
        "SELECT \r\n",
        "  metric as metricas,\r\n",
        "  value as valor\r\n",
        "FROM (\r\n",
        "  SELECT \r\n",
        "    CAST(min(data) AS STRING) as inicio_carga,\r\n",
        "    CAST(max(data) AS STRING) as carga_atual,\r\n",
        "    CAST(count(data) AS STRING) as tt_dias_processados\r\n",
        "  FROM (\r\n",
        "    SELECT data FROM open_meteo.silver.clima_dia_dia GROUP BY data\r\n",
        "  )\r\n",
        ") \r\n",
        "LATERAL VIEW stack(\r\n",
        "  3, \r\n",
        "  'Início da Carga', inicio_carga, \r\n",
        "  'Data Atual', carga_atual, \r\n",
        "  'Total de dias Processados', tt_dias_processados\r\n",
        ") as metric, value"
      ]
    }
  ],
