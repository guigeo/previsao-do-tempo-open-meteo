            }
          },
          "position": { "x": 8, "y": 6, "width": 4, "height": 4 }
        },
        {
          "widget": {
            "name": "vg_pie_chuva",
            "queries": [ { "name": "main_query", "query": { "datasetName": "classif_chuva", "fields": [ { "name": "sum(qtd)", "expression": "SUM(`qtd`)" }, { "name": "categoria", "expression": "`categoria`" } ], "disaggregated": false } } ],
