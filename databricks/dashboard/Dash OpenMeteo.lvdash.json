            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "temp_media_nacional", "displayName": "Temp. média (°C)", "format": { "type": "number", "decimalPlaces": { "type": "fixed", "places": 1 } } } },
              "frame": { "showTitle": true, "title": "Temperatura média nacional" }
            }
          },
          "position": { "x": 3, "y": 2, "width": 3, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_pct_chuva",
            "queries": [ { "name": "main_query", "query": { "datasetName": "kpis", "fields": [ { "name": "pct_dias_com_chuva", "expression": "`pct_dias_com_chuva`" } ], "disaggregated": true } } ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "pct_dias_com_chuva", "displayName": "% dias com chuva", "format": { "type": "number-percent", "decimalPlaces": { "type": "fixed", "places": 1 } } } },
              "frame": { "showTitle": true, "title": "Dias com chuva" }
